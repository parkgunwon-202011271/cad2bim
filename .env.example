# cad2bim LLM settings. Copy this file to .env and fill in the values.
# .env is in .gitignore and must never be committed or shared (API keys are secrets).
# Values already set as Windows environment variables win over this file.

# Which LLM to use: openai | gemini | anthropic | cache (stored answers only) | off
# Leave empty for rule-based conversion (cache: stored answers only, nothing is sent out).
CAD2BIM_LLM=
# Calls per minute (free Gemini tier: 14). Empty uses config llm.requests_per_minute.
CAD2BIM_LLM_RPM=

# OpenAI or OpenAI-compatible gateway (e.g. company OCI endpoint)
OPENAI_API_KEY=
# Leave empty for api.openai.com. For a company gateway, ask for its base URL (ends with /v1 in most cases).
OPENAI_BASE_URL=
# Model name the key is allowed to use (must accept images for drawing review), e.g. ask the key owner.
OPENAI_MODEL=

# Google Gemini (free tier: Flash-Lite only is practical)
GEMINI_API_KEY=
GEMINI_MODEL=

# Anthropic Claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
